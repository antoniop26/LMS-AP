# Supabase (proyecto gratuito: https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# PostgreSQL — use TRANSACTION pooler (port 6543) for Vercel/serverless.
# Session mode (5432) saturates quickly (EMAXCONNSESSION) and breaks dashboards.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Opcional: URL directa (5432) solo para migraciones locales
# DIRECT_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
