# Supabase (proyecto gratuito: https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# PostgreSQL (Settings > Database > Connection string > URI)
# Usa el connection pooling (puerto 6543) o directo (5432)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Opcional: URL directa para migraciones
# DIRECT_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
