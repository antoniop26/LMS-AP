generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  PROFESOR
  ALUMNO
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  LONG_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum MaterialFolderKind {
  TEACHER_RESOURCES
  STUDENT_SUBMISSIONS
}

model School {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  grades        Grade[]
  subjects      Subject[]
  announcements Announcement[]
}

model User {
  id           String   @id @default(cuid())
  supabaseId   String   @unique
  email        String   @unique
  fullName     String
  role         Role
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherSubjects TeacherSubject[]
  studentGroups   StudentGroup[]
  materials       Material[]
  materialFolders MaterialFolder[]
  testsCreated    Test[]           @relation("TestCreator")
  attempts        TestAttempt[]
  gradesGiven     AnswerGrade[]    @relation("Grader")
  announcements   Announcement[]

  @@index([schoolId])
  @@index([role])
}

model Grade {
  id        String   @id @default(cuid())
  name      String
  level     Int
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups    Group[]
  subjects  Subject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students        StudentGroup[]
  teacherSubjects TeacherSubject[]
  materials       Material[]
  materialFolders MaterialFolder[]
  tests           Test[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId   String?
  grade     Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherSubjects TeacherSubject[]
  materials       Material[]
  materialFolders MaterialFolder[]
  tests           Test[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, groupId])
  @@index([teacherId])
  @@index([subjectId])
}

model StudentGroup {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

model MaterialFolder {
  id          String             @id @default(cuid())
  name        String
  description String?
  kind        MaterialFolderKind
  subjectId   String
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  materials   Material[]

  @@index([subjectId])
  @@index([groupId])
  @@index([createdById])
  @@index([kind])
}

model Material {
  id           String          @id @default(cuid())
  title        String
  description  String?
  fileName     String
  filePath     String
  fileUrl      String?
  mimeType     String
  fileSize     Int?
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  folderId     String?
  folder       MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([subjectId])
  @@index([groupId])
  @@index([folderId])
  @@index([uploadedById])
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User     @relation("TestCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  published   Boolean  @default(false)
  maxScore    Float    @default(100)
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  attempts  TestAttempt[]

  @@index([subjectId])
  @@index([groupId])
  @@index([creatorId])
}

model Question {
  id           String       @id @default(cuid())
  testId       String
  test         Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  prompt       String
  type         QuestionType
  points       Float        @default(1)
  order        Int          @default(0)
  correctText  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  options Option[]
  answers Answer[]

  @@index([testId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

model TestAttempt {
  id          String        @id @default(cuid())
  testId      String
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Float?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  answers Answer[]

  @@unique([testId, studentId])
  @@index([studentId])
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAnswer String?
  optionId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  grade AnswerGrade?

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AnswerGrade {
  id        String   @id @default(cuid())
  answerId  String   @unique
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  points    Float
  feedback  String?
  gradedById String?
  gradedBy  User?    @relation("Grader", fields: [gradedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnnouncementKind {
  MESSAGE
  FLYER
  LINK
}

model Announcement {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind        AnnouncementKind
  title       String
  body        String?
  linkUrl     String?
  fileName    String?
  filePath    String?
  fileUrl     String?
  mimeType    String?
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  published   Boolean          @default(true)

  @@index([schoolId])
  @@index([createdById])
  @@index([createdAt])
}
